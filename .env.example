# Clé Google Maps Platform (JavaScript API + Places). Publique par nature :
# RESTREIGNEZ-LA par référent HTTP (votre domaine Vercel) dans Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="votre_cle_google_maps"

# Contact transmis aux services OpenStreetMap dans le User-Agent (politique d'usage Nominatim).
# Mettez une adresse e-mail ou l'URL de votre dépôt.
APP_CONTACT="https://github.com/Visitune/fouleefr"
